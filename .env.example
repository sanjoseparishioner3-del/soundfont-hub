# ---------- Frontend (safe to expose; prefixed VITE_) ----------
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
VITE_SITE_URL=https://soundfonthub.pages.dev

# ---------- Edge Function secrets (NEVER put in the frontend) ----------
# Set with:  supabase secrets set --env-file supabase/.env.secrets
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=soundfont-hub-private
# ALLOWED_ORIGIN=https://soundfonthub.pages.dev
# (SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected automatically into Edge Functions)
